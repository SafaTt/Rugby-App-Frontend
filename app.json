{
  "expo": {
    "name": "rugby-app",
    "slug": "rugby-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rugbyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/ball.jpg",

    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "navigationBar": {
        "visible": true,
        "backgroundColor": "#284268",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "resizeMode": "cover",
          "backgroundColor": "#0B0D21"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
